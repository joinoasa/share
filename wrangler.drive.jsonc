// Members' drive at share.joinoasa.org. Deployed by Cloudflare Workers Builds on every push to main.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oasa-share",
	"main": "src/drive.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./node_modules/r2-explorer/dashboard",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/share/*"]
	},
	// The only bucket this Worker can see. The binding name is what the drive shows.
	"r2_buckets": [{ "binding": "oasa-files", "bucket_name": "oasa-files" }],
	// No workers.dev or preview addresses: the custom domain, behind Cloudflare Access, is the only way in.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "share.joinoasa.org", "custom_domain": true }],
	"observability": { "enabled": true }
}
